      "items": [
        { "id": "allureQualityGate", "type": "qualityGate", "x": 0, "y": 0, "w": 5, "h": 2 },
        { "id": "sonarQualityGate", "type": "qualityGate", "x": 5, "y": 0, "w": 5, "h": 2 },
        { "type": "currentStatus", "x": 0, "y": 2, "w": 5, "h": 3 },
        { "type": "statusDynamics", "x": 5, "y": 2, "w": 5, "h": 3 },
        { "type": "testingPyramid", "x": 0, "y": 5, "w": 5, "h": 2 },
        { "type": "durations", "x": 5, "y": 5, "w": 5, "h": 2, "groupBy": "layer" },
        { "id": "testsTable", "type": "testsTable", "x": 0, "y": 7, "w": 10, "h": 3 }
      ],
      "pyramidFallback": "suites"
    },
    "links": {
      "report": "",
      "dashboard": "",
      "testops": "",
